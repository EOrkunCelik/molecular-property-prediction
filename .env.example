# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# ---- PostgreSQL ----
POSTGRES_USER=molpred
POSTGRES_PASSWORD=molpred_dev_password
POSTGRES_DB=molecular_predictions
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by the backend.
# When running via docker-compose, POSTGRES_HOST=db (the service name).
# When running the backend locally against docker-compose's Postgres, use POSTGRES_HOST=localhost.
DATABASE_URL=postgresql+psycopg2://molpred:molpred_dev_password@db:5432/molecular_predictions

# ---- Backend / API ----
API_V1_PREFIX=/api/v1
PROJECT_NAME=Molecular Property Prediction Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- ML model artifacts ----
# Path (inside the backend container) to the serialized model + metadata produced by scripts/train_model.py
MODEL_ARTIFACT_DIR=/app/models
MODEL_NAME=solubility_model

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
